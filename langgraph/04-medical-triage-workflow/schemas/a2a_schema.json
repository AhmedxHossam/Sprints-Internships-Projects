{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aegishealth:triage:a2a:1",
  "title": "AegisHealth triage handoff v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "patient_id": {"type": "string", "pattern": "^P-[0-9]{4}$"},
    "symptoms": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S"}
    },
    "triage_priority": {"type": "string", "enum": ["High", "Medium", "Low"]},
    "escalation_reason": {"type": "string", "minLength": 1, "maxLength": 500}
  },
  "required": ["patient_id", "symptoms", "triage_priority"]
}
